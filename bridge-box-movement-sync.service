[Unit]
Description=BridgeBox Movement List Sync (manual)
After=bridge-box-app.service

[Service]
# Manual/on-demand sync (via `bridge sync-movements`). Runs the radio-agnostic
# sync job after ensuring the client link is online (bb_run_online_window is now
# just "ensure online + run" — with a dedicated client radio the hotspot is
# never disturbed). There is intentionally NO timer for this — it runs in the
# boot online tasks (bridge-box-online-tasks) or by this manual command.
Type=oneshot
User=bridgebox
Environment=HOME=/home/bridgebox
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/bin/bash -c '. /home/bridgebox/bridge-box/bridge-box-wifi-lib.sh; bb_run_online_window "bash /home/bridgebox/bridge-box/bridge-box-movement-sync.sh"'
StandardOutput=journal
StandardError=journal
