# BridgeBox scorer .env template.
#
# The scorer app's .env is gitignored in its own repo, but the app needs it at
# BUILD time (the prebuild migration and next build read it). Since the box
# clones a fresh release each update, provisioning drops this file in as .env in
# every release dir before building.
#
# Paths are ABSOLUTE and point OUTSIDE the release dirs so databases live in one
# stable place that survives updates and is backed up (do not use ./data — that
# would resolve inside a release dir that gets pruned).
#
# Precedence note: the running app's authoritative values come from the PM2
# environment (see pm2.json), which wins over this file. This file exists mainly
# to satisfy the build; keep the two in sync.
#
# To override on a specific box, place a file at /home/bridgebox/scorer.env and
# provisioning will use that instead of this template.

DATABASE_URL=/home/bridgebox/data
DATABASE_GAMES_URL=/home/bridgebox/data/games

# Locale for the app's locale-specific logic. Baked into the build at build time
# (a NEXT_PUBLIC_ var). Do NOT rely on setting it here — provisioning derives the
# effective value from box-local /home/bridgebox/locale.conf (set at install via
# BRIDGE_LOCALE, default en-GB) and injects it into every build, overriding any
# value in this file. Valid: en-GB (default), en-US.
NEXT_PUBLIC_BRIDGE_LOCALE=en-GB
