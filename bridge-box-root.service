[Unit]
Description=BridgeBox Root Setup (hotspot/firewall)
After=network.target
Before=bridge-box-online-tasks.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/home/bridgebox/bridge-box/bridge-box-root.sh
User=root
# Run-once network setup. Do NOT auto-restart on failure: it (re)creates the
# hotspot each run, so restart-on-failure caused a delete/recreate loop on the
# AP radio (and cascaded into the update service). If it fails, it fails once
# and logs; the script itself retries the hotspot bring-up internally.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target