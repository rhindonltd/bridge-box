[Unit]
Description=BridgeBox App Update (download only)
After=bridge-box-root.service
Requires=bridge-box-root.service
# Run before the app service so a pending release is activated before the app
# starts, and the boot download happens before anyone is using the app.
Before=bridge-box-app.service

[Service]
Type=oneshot
ExecStart=/home/bridgebox/bridge-box/bridge-box-update.sh
User=bridgebox
Environment=HOME=/home/bridgebox
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
