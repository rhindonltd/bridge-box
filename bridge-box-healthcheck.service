[Unit]
Description=BridgeBox App Health Check
After=bridge-box-update.service

[Service]
Type=oneshot
ExecStart=/home/bridgebox/bridge-box/bridge-box-healthcheck.sh
User=bridgebox
# Don't reap the PM2 daemon when this oneshot exits.
KillMode=process
Environment=HOME=/home/bridgebox
Environment=PM2_HOME=/home/bridgebox/.pm2
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
StandardOutput=journal
StandardError=journal
